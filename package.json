    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^12.41.0",
    "geoip-lite": "^1.4.10",
    "gsap": "^3.15.0",
    "http-proxy-middleware": "^3.0.3",

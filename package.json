  "description": "Production-grade distributed rate limiting toolkit with 5 algorithms, WAF security, API gateway, SaaS dashboard, and Kubernetes integration",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./algorithms": "./lib/algorithms/index.js",
    "./middleware": "./lib/middleware/rateLimiter.js",

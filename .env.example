# ─── Server Configuration ───────────────────────────────
PORT=5000

# ─── Redis Connection ───────────────────────────────────
# For local development: use 127.0.0.1
# For Docker: set via docker-compose environment variables
# For Serverless (Vercel): provide REDIS_URL (e.g. from Upstash)
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
        